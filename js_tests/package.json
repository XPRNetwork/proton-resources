{
  "name": "resources-tests",
  "version": "1.0.0",
  "description": "VeRT tests for the resources (atom) contract",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "build:mocks": "eosio-cpp -abigen -I ../resources/include -contract mocksystem -o wasm/mocksystem.wasm mocks/mocksystem.cpp",
    "test": "mocha -s 250 --timeout 20000 'tests/**/*.spec.ts' -r ts-node/register",
    "test:plans": "mocha -s 250 --timeout 20000 tests/plans.spec.ts -r ts-node/register",
    "test:balances": "mocha -s 250 --timeout 20000 tests/balances.spec.ts -r ts-node/register",
    "test:subscriptions": "mocha -s 250 --timeout 20000 tests/subscriptions.spec.ts -r ts-node/register",
    "test:admin": "mocha -s 250 --timeout 20000 tests/admin.spec.ts -r ts-node/register"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XPRNetwork/proton-resources.git"
  },
  "license": "ISC",
  "dependencies": {
    "@greymass/eosio": "^0.5.5",
    "@proton/vert": "0.3.24",
    "chai": "^4.3.6",
    "mocha": "^9.2.2",
    "proton-tsc": "^0.3.8",
    "ts-node": "^10.7.0",
    "typescript": "^4.6.3"
  },
  "devDependencies": {
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.1.0",
    "@types/node": "^20.0.0",
    "patch-package": "^8.0.1"
  }
}
